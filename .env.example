# ─────────────────────────────────────────────
#  חובה — Required
# ─────────────────────────────────────────────

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# AES-256 encryption key for sensitive fields (bank tokens, payment keys)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key

# ─────────────────────────────────────────────
#  Google OAuth (optional — כניסה עם Google)
#  צור ב: console.cloud.google.com → APIs & Services → Credentials
#  Authorized redirect URI: https://yourdomain.com/api/auth/callback/google
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ─────────────────────────────────────────────
#  AI — חובה לצ'אט ולסריקת קבלות
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
#  מייל — Email (SMTP)
#  אפשרות 1: Gmail App Password
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# אפשרות 2: Resend (מומלץ לפרודקשן)
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@yourdomain.com

# ─────────────────────────────────────────────
#  תשלומים — Payment Processors (optional)
#  מוגדרים דרך הממשק per-business, לא כאן
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
#  Stripe (מנויים / billing)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# ─────────────────────────────────────────────
#  WhatsApp via Twilio (optional)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─────────────────────────────────────────────
#  Cron Jobs — הגן על endpoint עם סוד
# ─────────────────────────────────────────────
# Generate with: openssl rand -hex 24
CRON_SECRET=your-cron-secret

# ─────────────────────────────────────────────
#  Open Banking (optional — בנק ישראל sandbox)
# ─────────────────────────────────────────────
OPEN_BANKING_SANDBOX=true
# SHAAM_API_KEY=...
